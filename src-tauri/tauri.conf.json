{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Hydrogen Music",
  "version": "0.6.6",
  "identifier": "com.hydrogenmusic.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm prepare:tauri-sidecar && pnpm dev:tauri-ui",
    "beforeBuildCommand": "pnpm prepare:tauri-sidecar && pnpm build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Hydrogen Music",
        "width": 1080,
        "height": 672,
        "minWidth": 1080,
        "minHeight": 672,
        "center": true,
        "decorations": false,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/kugoumusicapi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
