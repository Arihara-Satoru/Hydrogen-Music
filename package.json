{
  "name": "hydrogenmusic",
  "private": true,
  "version": "0.6.8",
  "packageManager": "pnpm@10.26.0",
  "description": "A modern music player built with Electron and Vue.js",
  "main": "background.js",
  "author": {
    "name": "Arihara-Satoru",
    "email": "384678120@qq.com"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check:cloud-api": "node --experimental-vm-modules scripts/check-cloud-api.mjs",
    "check:cloud-metadata": "node scripts/check-cloud-metadata.cjs",
    "check:comment-api": "node --experimental-vm-modules scripts/check-comment-api.mjs",
    "check:comment-panel": "node scripts/check-comment-panel.mjs",
    "check:download-metadata": "node scripts/check-download-metadata.cjs",
    "check:download-quality": "node --experimental-vm-modules scripts/check-download-quality.mjs",
    "check:external-links": "node scripts/check-external-links.cjs",
    "check:foreground-memory": "node scripts/check-foreground-memory.mjs",
    "check:login-devices": "node --experimental-vm-modules scripts/check-login-devices.mjs",
    "check:logic-races": "node scripts/check-logic-races.mjs",
    "check:background-memory": "node scripts/check-background-memory.mjs",
    "check:loudness-normalization": "node scripts/check-loudness-normalization.mjs",
    "check:lyric-reveal": "node scripts/check-lyric-reveal.mjs",
    "check:purchased-api": "node --experimental-vm-modules scripts/check-purchased-api.mjs",
    "check:release-notes": "node scripts/check-release-notes.mjs",
    "check:siren-play-all": "node scripts/check-siren-play-all.mjs",
    "preview": "vite preview",
    "start": "node scripts/set-console-encoding.cjs && electron .",
    "start:watch": "node scripts/set-console-encoding.cjs && nodemon --exec electron . --watch ./ --ext js,vue,html,css,json",
    "_dist": "node scripts/build-kugou-api.cjs && vite build && node scripts/build.js -p always",
    "dist": "node scripts/build-kugou-api.cjs && vite build && node scripts/build.js -p never",
    "dist:local": "node scripts/build-kugou-api.cjs && vite build && node scripts/build.js -p never",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run"
  },
  "dependencies": {
    "axios": "^1.17.0",
    "dbus-next": "^0.10.2",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.3",
    "electron-win-state": "^1.1.22",
    "ffmpeg-static": "^5.3.0",
    "fs-extra": "^11.3.5",
    "iconv-lite": "^0.7.2",
    "metaflac-js": "^1.0.5",
    "motion-v": "^2.2.1",
    "mpris-service": "^2.1.2",
    "music-metadata": "^11.12.3",
    "nanoid": "^5.1.11",
    "node-id3": "^0.2.9",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@electron/rebuild": "^4.0.4",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "electron": "^42.3.3",
    "electron-builder": "26.15.1",
    "howler": "^2.2.4",
    "js-cookie": "^3.0.8",
    "js-md5": "^0.8.3",
    "nodemon": "^3.1.14",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "plyr": "^3.8.4",
    "qrcode": "^1.5.4",
    "rollup": "npm:@rollup/wasm-node@^4.61.0",
    "sass": "^1.100.0",
    "semantic-release": "^25.0.3",
    "terser": "^5.48.0",
    "vite": "^8.0.16",
    "vue": "^3.5.35",
    "vue-router": "^5.1.0",
    "vue-slider-component": "4.1.0-beta.7",
    "vue-virtual-scroller": "^3.0.4"
  }
}
